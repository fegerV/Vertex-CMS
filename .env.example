APP_NAME=VertexCMS
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_TIMEZONE=Europe/Moscow

VERTEX_VERSION=0.1.0
VERTEX_INSTALLED=false
VERTEX_THEME=default

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

CACHE_STORE=file
CACHE_PREFIX=vertex
QUEUE_CONNECTION=database
SESSION_DRIVER=file
FILESYSTEM_DISK=public

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# API Settings
API_PUBLIC_ENABLED=true

# PWA Settings
PWA_ENABLED=false
PWA_THEME_COLOR="#020617"
PWA_BACKGROUND_COLOR="#ffffff"
PWA_DISPLAY="standalone"
PWA_ORIENTATION="portrait"
PWA_SCOPE="/"
PWA_START_URL="/"
PWA_SHORT_NAME="VertexCMS"
PWA_NAME="VertexCMS"
PWA_DESCRIPTION="VertexCMS Progressive Web App"
PWA_ICONS="192,512"

# AI Settings
AI_ENABLED=false
AI_PROVIDER="openai"
AI_API_KEY=
AI_MODEL="gpt-4o-mini"
AI_MAX_TOKENS=1000

# AI Services - LEAVE EMPTY, SET IN PRODUCTION
OPENAI_API_KEY=

# Supabase for Vector Storage (RAG) - LEAVE EMPTY
SUPABASE_URL=
SUPABASE_KEY=

# Payment Gateways - LEAVE EMPTY
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# CDN / Cloud Storage (AWS S3 compatible) - LEAVE EMPTY
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=

# Telegram Notifications - LEAVE EMPTY
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Slack Notifications - LEAVE EMPTY
SLACK_WEBHOOK_URL=

# Sentry Error Tracking - LEAVE EMPTY
SENTRY_LARAVEL_DSN=
SENTRY_TRACING_ENABLED=true
SENTRY_SEND_DEFAULT_PII=false
SENTRY_MAX_BREADCRUMBS=50
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=

# Backup Settings
BACKUP_DATABASE_SCHEDULE=daily
BACKUP_FILES_SCHEDULE=weekly
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE=local

# Security Settings
GDPR_ENABLED=true
IP_FILTER_WHITELIST_MODE=false
SECURITY_WAF=true
SECURITY_WAF_MODE=block
SECURITY_GEOIP=false
SECURITY_GEOIP_DATABASE=
SECURITY_GEOIP_ALLOWED_COUNTRIES=
SECURITY_GEOIP_BLOCKED_COUNTRIES=
SECURITY_HIBP=true
SECURITY_HIBP_MINIMUM_OCCURRENCES=1
SECURITY_CLOUDFLARE=false
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_TRUST_VISITOR_HEADERS=false
CLOUDFLARE_TRUSTED_PROXIES=

# Analytics
ANALYTICS_ID=

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_API_MAX=60
RATE_LIMIT_API_DECAY=1
RATE_LIMIT_ADMIN_MAX=30
RATE_LIMIT_ADMIN_DECAY=1
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_DECAY=1

# Two-Factor Authentication
TWO_FACTOR_ENABLED=true
TWO_FACTOR_WINDOW=1

# Security Headers
CSP_ENABLED=true
