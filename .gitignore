```gitignore
# Compiled and binary files
*.pyc
__pycache__/
*.o
*.obj
*.so
*.a
*.dll
*.exe
*.out

# Dependencies
vendor/
node_modules/
.venv/
venv/
.env
.env.local
*.env.*

# Build artifacts
dist/
build/
target/
*.class

# Logs and temporary files
*.log
*.tmp
*.swp
*.swo

# Editor/IDE files
.vscode/
.idea/
*.iml
*.pyc
*.pyo
*.pyd
*.jar

# Coverage reports
coverage/
htmlcov/
.coverage

# OS files
.DS_Store
Thumbs.db

# Cache directories
.mypy_cache/
.pytest_cache/
.gradle/
```