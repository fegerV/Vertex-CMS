```
# Laravel-specific ignores
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*
!.gitkeep

# Testing cache
storage/framework/testing/.phpunit.cache/

# Lock files
*.lock

# Environment
.env
.env.local
.env.*
!.env.example

# Logs
*.log
storage/logs/*

# Temporary files
*.tmp
*.temp
```