APP_NAME=VertexCMS
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_TIMEZONE=Europe/Moscow

VERTEX_VERSION=0.1.0
VERTEX_INSTALLED=false
VERTEX_THEME=default

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

CACHE_STORE=file
CACHE_PREFIX=vertex
QUEUE_CONNECTION=database
SESSION_DRIVER=file
FILESYSTEM_DISK=public

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# API Settings
API_PUBLIC_ENABLED=true

# PWA Settings
PWA_ENABLED=false
PWA_THEME_COLOR="#020617"
PWA_BACKGROUND_COLOR="#ffffff"
PWA_DISPLAY="standalone"
PWA_ORIENTATION="portrait"
PWA_SCOPE="/"
PWA_START_URL="/"
PWA_SHORT_NAME="VertexCMS"
PWA_NAME="VertexCMS"
PWA_DESCRIPTION="VertexCMS Progressive Web App"
PWA_ICONS="192,512"

# AI Settings
AI_ENABLED=false
AI_DEFAULT_PROVIDER="openai"
AI_DEFAULT_MODEL="gpt-4o-mini"
AI_MAX_TOKENS=1000
AI_TEMPERATURE=0.7

# AI Feature Toggles
AI_FEATURE_BRAND_MONITOR=false
AI_FEATURE_CHAT_BOT=true
AI_FEATURE_CONTENT_GENERATION=true
AI_FEATURE_IMAGE_ANALYSIS=true
AI_FEATURE_RAG_CHAT=true
AI_FEATURE_SEMANTIC_SEARCH=true
AI_FEATURE_SITE_WIZARD=true
AI_FEATURE_DRAFT_SERVICE=true
AI_FEATURE_DOCUMENT_PROCESSING=true

# AI Services API Keys - LEAVE EMPTY, SET IN PRODUCTION
OPENAI_API_KEY=
OPENAI_ORGANIZATION=
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

CUSTOM_AI_API_KEY=
CUSTOM_AI_BASE_URL=
CUSTOM_AI_MODEL=

# Vector Storage for RAG (PgVector/Supabase/Pinecone/Qdrant)
VECTOR_STORAGE_DRIVER=database
VECTOR_DIMENSIONS=1536

# Supabase Vector Storage - LEAVE EMPTY
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_VECTOR_TABLE=documents
SUPABASE_QUERY_FUNCTION=match_documents

# Pinecone - LEAVE EMPTY
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX=

# Qdrant - LEAVE EMPTY
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_base

# AI Fallback Configuration
AI_FALLBACK_USE_STUBS=false
AI_FALLBACK_USE_CACHE=true
AI_FALLBACK_CACHE_TTL=3600
AI_FALLBACK_LOG_WARNINGS=true
AI_FALLBACK_NOTIFY_ON_FAILURE=false
AI_FALLBACK_NOTIFY_THRESHOLD=5

# AI Rate Limiting
AI_RATE_LIMIT_ENABLED=true
AI_RATE_LIMIT_PER_MINUTE=60
AI_RATE_LIMIT_PER_HOUR=1000
AI_RATE_LIMIT_TOKENS_PER_DAY=100000

# AI Logging
AI_LOG_REQUESTS=false
AI_LOG_RESPONSES=false
AI_LOG_ERRORS=true
AI_LOG_USAGE=true
AI_STORE_PROMPTS=false
AI_STORE_RESPONSES=false

# AI Content Settings
AI_CHUNK_SIZE=500
AI_CHUNK_OVERLAP=50
AI_BRAND_VOICE=
AI_CONTENT_LANGUAGE=ru

# AI Demo Mode (for demonstrations without real API calls)
AI_DEMO_MODE=false
AI_DEMO_SHOW_DISCLAIMER=true

# Payment Gateways - LEAVE EMPTY
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# CDN / Cloud Storage (AWS S3 compatible) - LEAVE EMPTY
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=

# Telegram Notifications - LEAVE EMPTY
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Slack Notifications - LEAVE EMPTY
SLACK_WEBHOOK_URL=

# Sentry Error Tracking - LEAVE EMPTY
SENTRY_LARAVEL_DSN=
SENTRY_TRACING_ENABLED=true
SENTRY_SEND_DEFAULT_PII=false
SENTRY_MAX_BREADCRUMBS=50
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=

# Backup Settings
BACKUP_DATABASE_SCHEDULE=daily
BACKUP_FILES_SCHEDULE=weekly
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE=local

# Security Settings
GDPR_ENABLED=true
IP_FILTER_WHITELIST_MODE=false
SECURITY_WAF=true
SECURITY_WAF_MODE=block
SECURITY_GEOIP=false
SECURITY_GEOIP_DATABASE=
SECURITY_GEOIP_ALLOWED_COUNTRIES=
SECURITY_GEOIP_BLOCKED_COUNTRIES=
SECURITY_HIBP=true
SECURITY_HIBP_MINIMUM_OCCURRENCES=1
SECURITY_CLOUDFLARE=false
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_TRUST_VISITOR_HEADERS=false
CLOUDFLARE_TRUSTED_PROXIES=

# Analytics
ANALYTICS_ID=

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_API_MAX=60
RATE_LIMIT_API_DECAY=1
RATE_LIMIT_ADMIN_MAX=30
RATE_LIMIT_ADMIN_DECAY=1
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_DECAY=1

# Two-Factor Authentication
TWO_FACTOR_ENABLED=true
TWO_FACTOR_WINDOW=1

# Security Headers
CSP_ENABLED=true
